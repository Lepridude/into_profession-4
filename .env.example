# Loginom REST API
LOGINOM_BASE_URL=https://edu.loginom.dev/lgi/rest
LOGINOM_PACKAGE=REPLACE_WITH_PUBLISHED_PACKAGE_NAME
LOGINOM_HISTORY_SERVICE=GetUserHistory
LOGINOM_CHECK_SERVICE=CheckUserId
LOGINOM_TIMEOUT=45

# GigaChat: add your real key locally, never commit .env
GIGA_KEY=PASTE_YOUR_GIGACHAT_AUTH_KEY_HERE
GIGA_MODEL=GigaChat-2
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=0
FLASK_DEBUG=0
